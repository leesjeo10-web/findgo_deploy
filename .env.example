# 아무것도 설정하지 않으면 내장 H2 DB(./data)로 실행됩니다.
# MySQL을 쓰려면 이 파일을 .env 로 복사하고 아래 주석을 풀어 값을 넣으세요. (.env는 git에 올리지 마세요)
# DB_URL=jdbc:mysql://localhost:3306/wine_finder?createDatabaseIfNotExist=true&serverTimezone=Asia/Seoul
# DB_USERNAME=root
# DB_PASSWORD=여기에_MySQL_비밀번호

# JWT 서명 비밀키(필수, 32바이트 이상의 무작위 문자열). 예: openssl rand -base64 48 로 만든 값
# JWT_SECRET=여기에_32바이트_이상_무작위_문자열
# 토큰 유효 시간(초). 생략하면 3600
# JWT_EXPIRES_SECONDS=3600
