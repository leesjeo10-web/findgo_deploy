// 찾Go ERD — dbdiagram.io에 붙여 넣으면 같은 구조의 그림이 나옵니다.

Enum item_type {
  LOST [note: '분실물']
  FOUND [note: '습득물']
}

Enum item_status {
  OPEN [note: '찾는 중']
  RESOLVED [note: '해결 완료']
}

Table members {
  id bigint [pk, increment]
  email varchar(254) [not null, unique, note: '소문자로 저장']
  name varchar(40) [not null]
  password_hash varchar(255) [not null, note: '암호화한 비밀번호, 응답에 넣지 않음']
  phone varchar(20) [note: '선택, 010-0000-0000. 물품 상세의 작성자 연락처']
}

Table items {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > members.id]
  type item_type [not null]
  name varchar(100) [not null]
  description text [not null]
  status item_status [not null, default: 'OPEN']
  location varchar(100) [not null]
  storage_location varchar(100) [note: '습득물(FOUND)이면 필수, 분실물은 NULL']
  image_url text
  lost_found_at date [not null, note: '분실·습득 날짜, 정렬에 쓰지 않음']
  created_at datetime [not null, note: '등록 일시, 목록 정렬 기준']
}

Table item_image {
  filename varchar(40) [pk]
  user_id bigint [not null, ref: > members.id]

  Note: '사진을 올린 사람 기록. items와 FK 없이 items.image_url의 파일 이름으로 연결. 글에 연결되지 않은 사진은 3시간 뒤 삭제'
}
